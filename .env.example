# IssueScout Environment Configuration Example
# Copy to .env for local configuration

# Server Configuration
PORT=4173
HOST=0.0.0.0

# GitHub Integration (Optional but recommended to avoid anonymous search rate limits)
# Create a Personal Access Token (classic) with public_repo read permission at https://github.com/settings/tokens
GITHUB_TOKEN=

# Local AI / Ollama Configuration (Optional - falls back gracefully to keyword matching if Ollama is offline)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Node Environment
NODE_ENV=production
